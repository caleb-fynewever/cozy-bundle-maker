# Server-side only. Never rename this to VITE_ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Generate at least 32 random characters; used only by the server to protect verification challenges.
EMAIL_VERIFICATION_SECRET=

# Required in Lovable production secrets; must point browser and server to the same project.
# Local development defaults to the public connection settings in vite.config.ts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Either naming convention works locally; the server names take precedence.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only Lovable transactional email credentials. Never use a VITE_ prefix.
LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# Server-only: paste your Supabase secret key here (sb_secret_... is supported).
SUPABASE_SERVICE_ROLE_KEY=
# Migration connection from Supabase Connect (Session pooler or direct connection).
LOVABLE_DB_MIGRATION_URL=
